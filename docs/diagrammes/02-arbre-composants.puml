@startuml 02-arbre-composants
title Site commercial  -  arbre des composants (props reelles)

skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam ArrowColor #44546A

rectangle "App  (cabliage)" as App {
}

card "DataProvider\n{ products, orders, stats }" as Store {
}

card "Layout\nstats.orderCount = 3" as Layout {
}

card "HomePage\netat : aucun" as Accueil {
  card "KpiCard x2\n{ label, children }" as K1
  card "table synthese\n{ byCategory[] }" as K2
}

card "ProductsPage\netat : filters, sort" as Produits {
  card "ProductFilter\n{ values, bounds, categories, resultCount, totalCount,\n  onSearchChange, onCategoryChange, onMaxPriceChange,\n  onMaxQuantityChange, onMaxThresholdChange,\n  onOnlyLowStockChange, onOnlyOutOfStockChange, onReset }" as F {
    card "Input / Checkbox / Range\n{ value, onChange }" as Atomes
  }
  card "TableProducts\n{ products: 13 filtres }" as T {
    card "TableCategory\n{ category, count }" as C
    card "RowProduct\n{ product }" as R
  }
}

card "OrderPage\netat : customer, quantities, status" as Commande {
  card "OrderRow\n{ product, quantity, onQuantityChange, error }" as L {
    card "QuantitySelector\n{ value, max = stock, onChange }" as S
  }
}

App --> Store
Store --> Layout
Layout --> Accueil
Layout --> Produits
Layout --> Commande
Accueil --> K1
Accueil --> K2
Produits --> F
Produits --> T
F --> Atomes
T --> C
T --> R
Commande --> L
L --> S

note right of Store
  Etat unique : les 3 pages
  lisent la MEME version des donnees.
end note

note bottom of R
  Aucun etat local dans les composants
  de presentation : tout vient des props.
end note

note bottom of C
  TableCategory ne connait aucun produit :
  seulement un titre de groupe et un compte.
end note

@enduml
