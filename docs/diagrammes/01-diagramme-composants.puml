@startuml 01-diagramme-composants
title Site commercial  -  diagramme de composants

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam packageStyle rectangle
skinparam ArrowColor #44546A
skinparam ArrowFontSize 12
skinparam nodesep 20
skinparam ranksep 50

package "src" #F1F5F9 {
  component "App.jsx\n(cablage : provider + router)" as App <<configuration>>
}

package "src/pages" #E8F5E9 {
  component "HomePage" as Accueil <<non standard>>
  component "ProductsPage" as Produits <<non standard>>
  component "OrderPage" as Commande <<non standard>>
}

package "src/components" #EAF1F8 {
  component "Layout\n(gabarit des 3 pages)" as Layout <<non standard>>
  component "form/Input" as Input <<standard>>
  component "form/Range" as Range <<standard>>
  component "form/Checkbox" as Check <<standard>>
  component "KpiCard" as KPI <<non standard>>
  component "ProductFilter" as Filtre <<non standard>>
  component "TableProducts" as Table <<non standard>>
  component "TableCategory" as Cat <<non standard>>
  component "RowProduct" as Row <<standard>>
  component "OrderRow" as Ligne <<standard>>
  component "QuantitySelector" as SelQ <<standard>>
}

package "src/store" #FFF4E5 {
  component "DataContext.jsx\n(etat partage)" as Store <<non standard>>
  component "selectors.js" as Sel <<fonctions pures>>
  component "state.js" as Etat <<transitions pures>>
  component "orderBuilder.js" as Builder <<pattern Builder>>
  component "orderStatus.js" as Statut <<machine a etats>>
}

package "src/data" #F4F6F8 {
  component "seed.js" as Seed <<donnees en dur>>
}

App --> Store : monte le provider
App --> Layout : monte le routeur

Accueil --> Store : useData()
Produits --> Store : useData()
Commande --> Store : useData()
Commande --> Builder : construit la commande
Commande --> Statut : etats du formulaire
Layout --> Store : stats, undoLastOperation()

Accueil --> KPI
Produits --> Filtre
Produits --> Table
Filtre --> Input
Filtre --> Check
Filtre --> Range
Table --> Cat
Table --> Row : product
Commande --> Ligne : product, quantity
Ligne --> SelQ : value, max

Store --> Sel : regles de calcul
Store --> Etat : transitions
Store --> Seed : donnees de depart
Builder --> Sel : validateOrder()

note bottom of Sel
  Utilise par TableProducts (groupByCategory),
  RowProduct (isLowStock), OrderRow (formatPrice)
  et OrderBuilder (validateOrder) — jamais l'inverse.
end note

note bottom of Store
  Instance unique pour toute l'application.
  Aucun composant ne lit seed.js directement :
  passer une commande modifie les 3 pages.
end note

@enduml
