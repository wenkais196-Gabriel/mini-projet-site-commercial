@startuml 04-diagramme-ports
title Site commercial - les ports des composants (notation du cours CCM)

skinparam componentStyle uml2
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam ArrowColor #44546A
skinparam ArrowFontSize 11
skinparam nodesep 55
skinparam ranksep 45
top to bottom direction

package "1. atomes (form/) - ils normalisent une valeur" #EAF1F8 {
  together {
    component "form/Input" as Input {
      portin "id, label, value" as in_p
      portout "onChange : string" as in_e
    }
    component "form/Range" as Range {
      portin "id, label, min, max, value" as rg_p
      portout "onChange : number" as rg_e
    }
    component "form/Checkbox" as Check {
      portin "id, label, checked" as ck_p
      portout "onChange : boolean" as ck_e
    }
    component "form/Select" as Select {
      portin "id, label, options[], value" as sl_p
      portout "onChange : string" as sl_e
    }
  }
}

package "2. controles composes, lignes de tableau, carte" #F3F6F0 {
  together {
    component "QuantitySelector\nvaleur bornee [0, max]" as Qty {
      portin "value, max, disabled" as q_p
      portout "onChange : number" as q_e
    }
    component "OrderRow" as ORow {
      portin "product, quantity, error" as o_p
      portout "onQuantityChange(id, qty)" as o_e
    }
    component "RowProduct" as RRow {
      portin "product" as r_p
    }
    component "TableCategory" as Cat {
      portin "category, count" as ca_p
    }
    component "KpiCard" as Kpi {
      portin "label + facette <children>" as k_p
    }
  }
}

package "3. composes et orchestrateurs" #FFF4E5 {
  together {
    component "TableProducts" as Table {
      portin "products" as tb_p
    }
    component "ProductFilter" as Filter {
      portin "values, bounds, categories, counts" as f_p
      portout "7 ports (1 par filtre)" as f_e
    }
  }
}

package "4. pages (assembleurs), gabarit et etat partage" #F4F6F8 {
  together {
    component "HomePage\n(etat local : aucun)" as Home
    component "ProductsPage\n(filters, sort)" as Products
    component "OrderPage\n(customer, quantities,\nreport, savedOrder, status)" as Order
    component "Layout" as Layout {
      portin "stats, canUndo, lastOperation" as ly_p
      portout "undoLastOperation, reset" as ly_e
    }
    component "DataProvider\n(composant non visuel)" as Store {
      portin "useData() : facette unique" as st_p
      portin "today : attribut injectable" as st_a
    }
  }
}

' bandes : 1 (atomes) -> 4 (pages)
Input -[hidden]-> Qty
Qty -[hidden]-> Table
Table -[hidden]-> Home

legend bottom
  |= Notation du cours (CCM) |= Dans le projet |
  | portin (bord haut) : Receives From | attributs recus + facette (<children>) |
  | portout (bord bas) : Sends To | event sources produits (onChange...) |
  | Attributes | nommes dans les portin (props de donnees) |
  L'axe est vertical (haut/bas) ici au lieu de gauche/droite comme sur la
  diapositive du cours : les portes et leur sens sont identiques.
  De haut en bas : atomes -> controles composes -> composes -> pages.
end legend

note right of Filter
  Comme dans le cours : un port de sortie
  par filtre, au lieu d'un gros objet
  renvoye au parent.
end note

note right of Store
  Facette unique : toutes les pages
  "Receives From" ici. Aucune page
  ne parle directement a une autre.
end note

@enduml
